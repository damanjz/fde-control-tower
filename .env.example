# Copy to .env (gitignored) and change every value. Used by docker compose, the tower, the simulator and tests.
CT_DB_PASSWORD=change-me-db-password
# Optional: full URL. Built from CT_DB_PASSWORD when empty.
CT_DATABASE_URL=
# HMAC secret shared by the GPS senders and the tower.
CT_GPS_SECRET=change-me-gps-secret
# Admin endpoints on the tower (dead-letter replay/discard, audit log).
CT_ADMIN_KEY=change-me-admin
# Key the poller sends to the carrier API, and the key for the carrier API's fault-injection admin endpoint.
CT_CARRIER_API_KEY=change-me-carrier-key
CT_CARRIER_ADMIN_KEY=change-me-carrier-admin
# Milestone 2: one bearer token per user (generate: python -c "import secrets; print(secrets.token_urlsafe(24))").
# asha = VP Operations (all India), kiran = Dispatcher South (DC-HYD only), meera = Finance (all India).
CT_TOKEN_ASHA=change-me-asha-token
CT_TOKEN_KIRAN=change-me-kiran-token
CT_TOKEN_MEERA=change-me-meera-token
# Optional overrides: local LLM (Ollama) and the mock chat webhook the outbox posts to.
# CT_LLM_URL=http://localhost:11434
# CT_LLM_MODEL=fusion27b:iq3
# CT_CHAT_WEBHOOK_URL=http://127.0.0.1:9100/hooks/chat

# optional: an interpreter with reportlab for the simulator PDFs (default: the one running the simulator)
# CT_PDF_PYTHON=
